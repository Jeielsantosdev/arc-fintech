# ─── Arc Blockchain ────────────────────────────────────────────────────────────
# Arc testnet RPC (comma-separated for automatic failover)
ARC_RPC_URL=https://rpc.arc.testnet.circle.com
ARC_CHAIN_ID=5042002

# Hot wallet private key used by PaymentAgent to sign and broadcast transactions
# WARNING: In production use a KMS (AWS KMS, HashiCorp Vault, etc.)
ARC_PRIVATE_KEY=0x_your_platform_hot_wallet_private_key

# ─── Arc DevKit / Anthropic ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fintech:fintech_pass@localhost:5432/arc_fintech

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ──────────────────────────────────────────────────────────────────
# 32-byte secret for Fernet wallet key encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
KEY_ENCRYPTION_SECRET=your_fernet_key_here

# Secret for HMAC-SHA256 webhook signatures
WEBHOOK_SECRET=your_webhook_secret_here

# JWT secret for API authentication
JWT_SECRET=your_jwt_secret_here

# ─── Platform Addresses ────────────────────────────────────────────────────────
# Platform hot wallet that receives the platform split (10%)
PLATFORM_WALLET_ADDRESS=0x_your_platform_wallet_address

# USDC contract address on Arc (testnet placeholder — update when Circle publishes)
USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ─── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Idempotency key TTL in seconds (24h)
IDEMPOTENCY_TTL=86400

# Payment confirmation timeout (seconds)
PAYMENT_TIMEOUT=120

# Subscription retry attempts before suspension
SUBSCRIPTION_MAX_RETRIES=3

# Webhook delivery timeout (seconds)
WEBHOOK_TIMEOUT=10
